#!/usr/bin/env bash
set -euo pipefail

BASE="https://hatchbox.io/api/v1"
GLOBAL_CONFIG="$HOME/.hatchbox"
CONFIG=""
ENV_NAME=""
APP_ID=""
TOKEN=""
POLL_SECONDS=3

RESP_CODE=""
RESP_BODY=""

die() {
  echo "$1" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required and is not installed"
}

# config files are "key = value", one per line, # starts a full line comment.
# keys that vary by environment carry it after a colon, app_id:production.
config_get() {
  local file="$1" key="$2"
  [ -f "$file" ] || return 0
  awk -v want="$key" '
    /^[ \t]*#/ { next }
    /=/ {
      k = $0
      sub(/=.*/, "", k)
      gsub(/^[ \t]+|[ \t]+$/, "", k)
      if (k != want) next
      v = $0
      sub(/^[^=]*=/, "", v)
      gsub(/^[ \t]+|[ \t]+$/, "", v)
      print v
    }
  ' "$file" | tail -1
}

config_set() {
  local key="$1" value="$2" tmp
  [ -n "$CONFIG" ] || return 0
  if [ ! -w "$CONFIG" ]; then
    echo "could not write $key to $CONFIG, it is not writable" >&2
    return 0
  fi
  tmp="$(mktemp)"
  awk -v want="$key" -v value="$value" '
    BEGIN { written = 0 }
    /^[ \t]*#/ { print; next }
    {
      k = $0
      if (k ~ /=/) {
        sub(/=.*/, "", k)
        gsub(/^[ \t]+|[ \t]+$/, "", k)
        if (k == want) {
          if (!written) { print want " = " value; written = 1 }
          next
        }
      }
      print
    }
    END { if (!written) print want " = " value }
  ' "$CONFIG" > "$tmp" && mv "$tmp" "$CONFIG"
}

# an app is a bare line, the app as the dashboard url spells it, then its
# environment: 13673-fpd:production. prints "env<tab>app" for each one.
config_apps() {
  [ -n "$CONFIG" ] || return 0
  awk '
    /^[ \t]*#/ { next }
    /=/ { next }
    {
      line = $0
      gsub(/^[ \t]+|[ \t]+$/, "", line)
      if (line == "") next
      cut = 0
      for (i = 1; i <= length(line); i++) if (substr(line, i, 1) == ":") cut = i
      if (cut == 0) next
      app = substr(line, 1, cut - 1)
      env = substr(line, cut + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", app)
      gsub(/^[ \t]+|[ \t]+$/, "", env)
      if (app != "" && env != "") print env "\t" app
    }
  ' "$CONFIG"
}

config_envs() {
  config_apps | cut -f1
}

config_app_for() {
  config_apps | awk -F'\t' -v want="$1" '$1 == want { print $2 }' | tail -1
}

find_config() {
  local dir="$PWD"
  while :; do
    # ~/.hatchbox is the token file, never an app's config
    if [ -f "$dir/.hatchbox" ] && [ "$dir/.hatchbox" != "$GLOBAL_CONFIG" ]; then
      printf '%s' "$dir/.hatchbox"
      return 0
    fi
    [ "$dir" = "/" ] && return 1
    dir="$(dirname "$dir")"
  done
}

load_config() {
  CONFIG="$(find_config || true)"
  [ -n "$CONFIG" ] || die "no .hatchbox found here or above $PWD. see hatchbox --help for the format"

  local envs count
  envs="$(config_envs)"
  count="$(printf '%s' "$envs" | grep -c . || true)"
  [ "$count" -gt 0 ] || die "$CONFIG names no app, so there is nothing to talk to. see hatchbox --help"

  if [ -z "$ENV_NAME" ]; then
    ENV_NAME="${HATCHBOX_ENV:-}"
  fi
  if [ -z "$ENV_NAME" ]; then
    ENV_NAME="$(config_get "$CONFIG" default)"
  fi
  if [ -z "$ENV_NAME" ] && [ "$count" -eq 1 ]; then
    ENV_NAME="$envs"
  fi
  if [ -z "$ENV_NAME" ]; then
    echo "$CONFIG has more than one environment and no default line, so pick one with -e" >&2
    echo >&2
    printf '  %s\n' $envs >&2
    exit 1
  fi

  APP_ID="$(config_app_for "$ENV_NAME")"
  if [ -z "$APP_ID" ]; then
    echo "no app is listed for $ENV_NAME in $CONFIG" >&2
    echo >&2
    echo "environments it does know about:" >&2
    printf '  %s\n' $envs >&2
    exit 1
  fi

  TOKEN="${HATCHBOX_API_TOKEN:-}"
  [ -n "$TOKEN" ] || TOKEN="$(config_get "$GLOBAL_CONFIG" "token:$ENV_NAME")"
  [ -n "$TOKEN" ] || TOKEN="$(config_get "$GLOBAL_CONFIG" token)"
  [ -n "$TOKEN" ] || die "no api token. put 'token = ...' in $GLOBAL_CONFIG or set HATCHBOX_API_TOKEN"
}

api() {
  local method="$1" path="$2"
  shift 2
  local raw
  raw="$(curl -sS -X "$method" "$BASE$path" \
    -H "Authorization: Bearer $TOKEN" \
    -H "Accept: application/json" \
    "$@" -w $'\n%{http_code}')" || die "request to $path failed"
  RESP_CODE="${raw##*$'\n'}"
  RESP_BODY="${raw%$'\n'*}"
}

api_ok() {
  api "$@"
  case "$RESP_CODE" in
    2*) return 0 ;;
  esac
  local message
  message="$(printf '%s' "$RESP_BODY" | jq -r '.error // (.errors | if type == "array" then join(", ") else . end) // empty' 2>/dev/null || true)"
  [ -n "$message" ] || message="http $RESP_CODE"
  die "hatchbox said: $message"
}

server_name() {
  local id="$1" cluster names name
  api GET "/apps/$APP_ID"
  cluster="$(printf '%s' "$RESP_BODY" | jq -r '.cluster_id // empty' 2>/dev/null || true)"
  if [ -n "$cluster" ]; then
    api GET "/clusters/$cluster"
    names="$(printf '%s' "$RESP_BODY" | jq -r '.servers[]? | "\(.id)\t\(.name)"' 2>/dev/null || true)"
    name="$(printf '%s\n' "$names" | awk -F'\t' -v id="$id" '$1 == id { print $2 }')"
  fi
  [ -n "${name:-}" ] && printf '%s' "$name" || printf 'server %s' "$id"
}

emit_new() {
  local key="$1" new="$2" dir="$3"
  local old="$dir/$key" oldlen newlen
  [ -f "$old" ] || : > "$old"
  oldlen="$(wc -c < "$old" | tr -d ' ')"
  newlen="$(wc -c < "$new" | tr -d ' ')"
  if [ "$oldlen" -eq 0 ]; then
    [ "$newlen" -gt 0 ] && cat "$new"
  elif [ "$newlen" -gt "$oldlen" ] && head -c "$oldlen" "$new" | cmp -s - "$old"; then
    tail -c "+$((oldlen + 1))" "$new"
  elif ! cmp -s "$old" "$new"; then
    cat "$new"
  fi
  cp "$new" "$old"
}

follow_log() {
  local log_id="$1" dir tmp state owner
  dir="$(mktemp -d)"
  tmp="$dir/fetch"
  trap "rm -rf '$dir'" RETURN

  while :; do
    api_ok GET "/logs/$log_id"
    state="$(printf '%s' "$RESP_BODY" | jq -r '.state // "unknown"')"

    printf '%s' "$RESP_BODY" | jq -j '.body // ""' > "$tmp"
    emit_new parent "$tmp" "$dir"

    local child_ids child_id
    child_ids="$(printf '%s' "$RESP_BODY" | jq -r '.child_logs[]?.id')"
    for child_id in $child_ids; do
      printf '%s' "$RESP_BODY" | jq -j --argjson cid "$child_id" \
        '.child_logs[] | select(.id == $cid) | .body // ""' > "$tmp"
      if [ -s "$tmp" ] && [ ! -f "$dir/header-$child_id" ]; then
        owner="$(printf '%s' "$RESP_BODY" | jq -r --argjson cid "$child_id" \
          '.child_logs[] | select(.id == $cid) | .loggable_id // empty')"
        echo
        echo "output from $(server_name "$owner")"
        : > "$dir/header-$child_id"
      fi
      emit_new "child-$child_id" "$tmp" "$dir"
    done

    case "$state" in
      completed)
        echo
        echo "completed"
        return 0
        ;;
      failed|aborted)
        echo
        echo "$state"
        return 1
        ;;
    esac

    sleep "$POLL_SECONDS"
  done
}

show_log() {
  local log_id="$1" state name sha description username
  api_ok GET "/logs/$log_id"
  state="$(printf '%s' "$RESP_BODY" | jq -r '.state // "unknown"')"
  name="$(printf '%s' "$RESP_BODY" | jq -r '.name // "unknown"')"
  sha="$(printf '%s' "$RESP_BODY" | jq -r '.commit_sha // empty')"
  description="$(printf '%s' "$RESP_BODY" | jq -r '.description // empty')"
  username="$(printf '%s' "$RESP_BODY" | jq -r '.username // empty')"

  echo "log $log_id, $name, $state"
  [ -n "$sha" ] && echo "commit ${sha:0:7}${description:+ $description}"
  [ -n "$username" ] && echo "started by $username"
  echo

  follow_log "$log_id"
}

cmd_deploy() {
  local sha="" follow=1 want_status=0

  while [ $# -gt 0 ]; do
    case "$1" in
      status|--status) want_status=1 ;;
      --sha) shift; [ $# -gt 0 ] || die "--sha needs a commit"; sha="$1" ;;
      --sha=*) sha="${1#--sha=}" ;;
      --no-follow) follow=0 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown option for deploy: $1" ;;
    esac
    shift
  done

  [ "$want_status" -eq 1 ] && { cmd_status; return; }

  local args=()
  [ -n "$sha" ] && args=(-H "Content-Type: application/json" -d "{\"sha\":\"$sha\"}")

  api_ok POST "/apps/$APP_ID/deploy" "${args[@]+"${args[@]}"}"

  local log_id
  log_id="$(printf '%s' "$RESP_BODY" | jq -r '.id // empty')"
  [ -n "$log_id" ] || die "hatchbox accepted the deploy but returned no log id: $RESP_BODY"

  config_set "last_deploy:$ENV_NAME" "$log_id"
  echo "queued deploy to $ENV_NAME, log $log_id"

  if [ "$follow" -eq 0 ]; then
    echo "follow it with: hatchbox -e $ENV_NAME logs $log_id"
    return 0
  fi

  echo
  follow_log "$log_id"
}

cmd_status() {
  local sha at log_id

  api_ok GET "/apps/$APP_ID"
  sha="$(printf '%s' "$RESP_BODY" | jq -r '.last_deploy_sha // empty')"
  at="$(printf '%s' "$RESP_BODY" | jq -r '.last_deploy_at // empty')"

  echo "$ENV_NAME, app $APP_ID"
  if [ -n "$sha" ]; then
    echo "last deploy ${sha:0:7}${at:+ at $at}"
    echo "full sha $sha"
  else
    echo "no deploy recorded on this app yet"
  fi
  echo

  log_id="$(config_get "$CONFIG" "last_deploy:$ENV_NAME")"
  if [ -n "$log_id" ]; then
    show_log "$log_id"
  else
    echo "no deploy log to stream"
    echo "hatchbox only serves a log by its id and has no endpoint that lists them, so the"
    echo "only ids around are the ones written back to"
    echo "  $CONFIG"
    echo "deploy from here and the next one is streamable, or pass an id off the dashboard"
    echo "url to hatchbox logs"
  fi
}

cmd_restart() {
  api_ok POST "/apps/$APP_ID/restart"
  local log_id
  log_id="$(printf '%s' "$RESP_BODY" | jq -r '.id // empty')"
  [ -n "$log_id" ] || die "hatchbox accepted the restart but returned no log id: $RESP_BODY"
  config_set "last_restart:$ENV_NAME" "$log_id"
  echo "queued restart of $ENV_NAME, log $log_id"
  echo
  follow_log "$log_id"
}

cmd_envs() {
  local env app current
  echo "environments in $CONFIG"
  while IFS=$'\t' read -r env app; do
    [ -n "$env" ] || continue
    current=""
    [ "$env" = "$ENV_NAME" ] && current=" (in use)"
    echo "  $env, app $app$current"
  done < <(config_apps)
}

list_types() {
  local deploy_id restart_id
  deploy_id="$(config_get "$CONFIG" "last_deploy:$ENV_NAME")"
  restart_id="$(config_get "$CONFIG" "last_restart:$ENV_NAME")"

  echo "log types for $ENV_NAME"
  if [ -n "$deploy_id" ]; then
    echo "  deploy    log $deploy_id"
  else
    echo "  deploy    nothing recorded yet"
  fi
  if [ -n "$restart_id" ]; then
    echo "  restart   log $restart_id"
  else
    echo "  restart   nothing recorded yet"
  fi
  echo
  echo "or pass a log id straight through: hatchbox logs 4212"

  if [ -z "$deploy_id$restart_id" ]; then
    echo
    echo "hatchbox serves a log by id only, with no endpoint to list them, so the only"
    echo "record of which ids belong to this app is"
    echo "  $CONFIG"
    echo "which fills in as you deploy."
  fi
}

cmd_logs() {
  local arg="${1:-}"

  case "$arg" in
    "") list_types; return 0 ;;
    -h|--help) usage; return 0 ;;
  esac

  local log_id
  if [[ "$arg" =~ ^[0-9]+$ ]]; then
    log_id="$arg"
  else
    case "$arg" in
      deploy|deploys) arg=deploy ;;
      restart|restarts) arg=restart ;;
      *)
        echo "no log type called $arg" >&2
        echo >&2
        list_types >&2
        return 1
        ;;
    esac
    log_id="$(config_get "$CONFIG" "last_${arg}:$ENV_NAME")"
    [ -n "$log_id" ] || die "no $arg has been started from here for $ENV_NAME, so there is no log id to fetch"
  fi

  show_log "$log_id"
}

urldecode() {
  local s="${1//+/ }"
  printf '%b' "${s//%/\\x}"
}

# splits postgresql://user:pass@host:port/name?sslmode=... into the URI_ globals,
# because handing psql a uri would put the password in ps output
parse_pg_uri() {
  local uri="$1" rest creds hostport dbpart query
  URI_USER=""; URI_PASS=""; URI_HOST=""; URI_PORT="5432"; URI_NAME=""; URI_SSLMODE=""

  rest="${uri#*://}"
  case "$rest" in
    *@*)
      creds="${rest%%@*}"
      rest="${rest#*@}"
      URI_USER="$(urldecode "${creds%%:*}")"
      case "$creds" in
        *:*) URI_PASS="$(urldecode "${creds#*:}")" ;;
      esac
      ;;
  esac

  hostport="${rest%%/*}"
  case "$hostport" in
    *:*) URI_HOST="${hostport%:*}"; URI_PORT="${hostport##*:}" ;;
    *)   URI_HOST="$hostport" ;;
  esac

  dbpart="${rest#*/}"
  URI_NAME="$(urldecode "${dbpart%%\?*}")"
  case "$dbpart" in
    *\?*)
      query="${dbpart#*\?}"
      URI_SSLMODE="$(printf '%s' "$query" | tr '&' '\n' | awk -F= '$1 == "sslmode" { print $2 }' | tail -1)"
      ;;
  esac
}

APP_JSON=""
SERVERS_JSON=""

load_app() {
  [ -n "$APP_JSON" ] && return 0
  api_ok GET "/apps/$APP_ID"
  APP_JSON="$RESP_BODY"
}

load_servers() {
  [ -n "$SERVERS_JSON" ] && return 0
  load_app
  local cluster
  cluster="$(printf '%s' "$APP_JSON" | jq -r '.cluster_id // empty')"
  [ -n "$cluster" ] || die "app $APP_ID is on no cluster, so there is no server to reach"
  api_ok GET "/clusters/$cluster"
  SERVERS_JSON="$(printf '%s' "$RESP_BODY" | jq -c '.servers // []')"
}

# single quotes the argument for a remote shell
sq() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

server_line() {
  printf '%s' "$1" | jq -r '"\(.name // "unnamed")  \(.public_ip // "no public ip")  \((.roles // []) | join(", "))"'
}

# echoes one server object, asking when the filter leaves more than one
pick_server() {
  local filter="${1:-}" pool count choice
  load_servers
  pool="$SERVERS_JSON"

  if [ -n "$filter" ]; then
    pool="$(printf '%s' "$pool" | jq -c --arg f "$filter" '
      [ .[] | select(
          ((.name // "") | ascii_downcase | contains($f | ascii_downcase))
          or (((.roles // []) | map(ascii_downcase)) | index($f | ascii_downcase) != null)
        ) ]')"
  fi

  count="$(printf '%s' "$pool" | jq 'length')"

  if [ "$count" -eq 0 ]; then
    if [ -n "$filter" ]; then
      echo "no server called $filter, and none with that role" >&2
    else
      echo "that cluster has no servers" >&2
    fi
    echo >&2
    printf '%s' "$SERVERS_JSON" | jq -r '.[] | "  \(.name // "unnamed")  \((.roles // []) | join(", "))"' >&2
    return 1
  fi

  if [ "$count" -eq 1 ]; then
    printf '%s' "$pool" | jq -c '.[0]'
    return 0
  fi

  if ! have_tty; then
    echo "that cluster has more than one server, so name one with --server" >&2
    echo >&2
    printf '%s' "$pool" | jq -r '.[] | "  \(.name // "unnamed")  \((.roles // []) | join(", "))"' >&2
    return 1
  fi

  echo "servers on this cluster" >&2
  printf '%s' "$pool" | jq -r 'to_entries[] | "  \(.key + 1)  \(.value.name // "unnamed")  \((.value.roles // []) | join(", "))"' >&2
  echo >&2
  printf 'which one? ' >&2
  read -r choice < /dev/tty
  case "$choice" in
    ''|*[!0-9]*) echo "that is not a number" >&2; return 1 ;;
  esac
  if [ "$choice" -lt 1 ] || [ "$choice" -gt "$count" ]; then
    echo "there is no $choice on that list" >&2
    return 1
  fi
  printf '%s' "$pool" | jq -c --argjson i "$((choice - 1))" '.[$i]'
}

SSH_HOST=""
SSH_USER=""
SSH_PORT=""
SSH_SERVER=""

# fills the SSH_ globals from the config, falling back to the cluster
resolve_ssh() {
  local want_server="${1:-}"
  SSH_SERVER=""
  SSH_HOST="$(config_get "$CONFIG" "ssh_host:$ENV_NAME")"
  SSH_USER="$(config_get "$CONFIG" "ssh_user:$ENV_NAME")"
  SSH_PORT="$(config_get "$CONFIG" "ssh_port:$ENV_NAME")"

  if [ -z "$SSH_HOST" ]; then
    SSH_SERVER="$(pick_server "$want_server")" || return 1
    SSH_HOST="$(printf '%s' "$SSH_SERVER" | jq -r '.public_ip // empty')"
    [ -n "$SSH_PORT" ] || SSH_PORT="$(printf '%s' "$SSH_SERVER" | jq -r '.ssh_port // empty')"
    [ -n "$SSH_HOST" ] || die "$(printf '%s' "$SSH_SERVER" | jq -r '.name // "that server"') has no public ip. set ssh_host:$ENV_NAME in $CONFIG"
  fi
  [ -n "$SSH_USER" ] || SSH_USER=deploy
  [ -n "$SSH_PORT" ] || SSH_PORT=22
}

# where the live release sits, resolve_ssh first
app_dir_for() {
  local dir
  dir="$(config_get "$CONFIG" "app_dir:$ENV_NAME")"
  if [ -z "$dir" ]; then
    load_app
    local name
    name="$(printf '%s' "$APP_JSON" | jq -r '.name // empty')"
    [ -n "$name" ] && dir="/home/$SSH_USER/$name/current"
  fi
  printf '%s' "$dir"
}

# the directory name the app is deployed under, which is what the motd lists
app_name_hint() {
  local dir
  dir="$(config_get "$CONFIG" "app_dir:$ENV_NAME")"
  if [ -n "$dir" ]; then
    dir="${dir%/}"
    dir="${dir%/current}"
    printf '%s' "${dir##*/}"
    return 0
  fi
  load_app
  printf '%s' "$APP_JSON" | jq -r '.name // empty'
}

# the motd hatchbox writes names every app on the box and the rails console line
# for each, so this reads the release directory back out of it and lands there
rails_remote() {
  local app="$1" rest="$2"
  printf 'app=%s\n' "$(sq "$app")"
  cat <<'REMOTE'
motd=$( { cat /run/motd.dynamic /etc/motd ; } 2>/dev/null || true )
case "$motd" in
  *"bin/rails console"*) ;;
  *)
    if [ -d /etc/update-motd.d ]; then
      motd="$motd
$(run-parts /etc/update-motd.d 2>/dev/null || true)"
    fi
    ;;
esac
dirs=$(printf '%s\n' "$motd" \
  | sed -n 's|.*cd  *\([^ ][^ ]*/current\)  *&&  *bin/rails console.*|\1|p' \
  | sed "s|^~|$HOME|" \
  | sort -u)
if [ -z "$dirs" ]; then
  dirs=$(for d in "$HOME"/*/current; do [ -x "$d/bin/rails" ] && printf '%s\n' "$d"; done)
fi
if [ -z "$dirs" ]; then
  echo "no rails app here. the motd lists none and nothing under $HOME/*/current has bin/rails" >&2
  exit 1
fi
pick=
for d in $dirs; do
  case "$d" in
    */"$app"/current) pick=$d ;;
  esac
done
if [ -z "$pick" ]; then
  n=$(printf '%s\n' "$dirs" | grep -c .)
  if [ "$n" = 1 ]; then
    pick=$dirs
  else
    echo "this server holds more than one rails app and none of them is $app:" >&2
    printf '  %s\n' $dirs >&2
    echo "say which with app_dir in .hatchbox" >&2
    exit 1
  fi
fi
[ -d "$pick" ] || { echo "$pick is not there, so nothing is deployed yet" >&2; exit 1; }
cd "$pick" || exit 1
REMOTE
  printf 'exec bin/rails %s\n' "$rest"
}

cmd_run() {
  local want_server="" parts=() passthru=()

  while [ $# -gt 0 ]; do
    case "$1" in
      -s|--server) shift; [ $# -gt 0 ] || die "--server needs a name or a role"; want_server="$1" ;;
      --server=*) want_server="${1#--server=}" ;;
      -h|--help) usage; return 0 ;;
      --) shift; passthru=("$@"); break ;;
      -*) die "unknown option for run: $1. quote the command, and put ssh's own flags after a --" ;;
      *) parts+=("$1") ;;
    esac
    shift
  done

  [ ${#parts[@]} -gt 0 ] || die "run needs a command, quoted as one argument"
  local command="${parts[*]}"

  resolve_ssh "$want_server" || return 1

  local script rest app_dir
  case "$command" in
    rails|rails\ *|bin/rails|bin/rails\ *)
      rest="${command#bin/}"
      rest="${rest#rails}"
      rest="${rest# }"
      app_dir="$(config_get "$CONFIG" "app_dir:$ENV_NAME")"
      if [ -n "$app_dir" ]; then
        script="cd $(sq "$app_dir") || exit 1
exec bin/rails $rest"
      else
        script="$(rails_remote "$(app_name_hint)" "$rest")"
      fi
      ;;
    *)
      app_dir="$(app_dir_for)"
      script=""
      [ -n "$app_dir" ] && script="cd $(sq "$app_dir") 2>/dev/null
"
      script="$script$command"
      ;;
  esac

  local args=(-p "$SSH_PORT")
  [ ${#passthru[@]} -gt 0 ] && args+=("${passthru[@]}")
  [ -t 1 ] && args+=(-t)

  ssh "${args[@]}" "$SSH_USER@$SSH_HOST" "bash -lc $(sq "$script")"
}

cmd_ssh() {
  local command="" want_server="" passthru=()

  while [ $# -gt 0 ]; do
    case "$1" in
      -s|--server) shift; [ $# -gt 0 ] || die "--server needs a name or a role"; want_server="$1" ;;
      --server=*) want_server="${1#--server=}" ;;
      -h|--help) usage; return 0 ;;
      --) shift; passthru=("$@"); break ;;
      -*) die "unknown option for ssh: $1. put ssh's own flags after a --" ;;
      *)
        [ -z "$command" ] || die "only one command at a time, quote it as one argument"
        command="$1"
        ;;
    esac
    shift
  done

  resolve_ssh "$want_server" || return 1

  local ssh_host="$SSH_HOST" ssh_user="$SSH_USER" ssh_port="$SSH_PORT" server="$SSH_SERVER"
  local app_dir
  app_dir="$(app_dir_for)"

  local target="$ssh_user@$ssh_host" remote=""
  [ -n "$app_dir" ] && remote="cd $(sq "$app_dir") 2>/dev/null; "

  local args=(-p "$ssh_port")
  [ ${#passthru[@]} -gt 0 ] && args+=("${passthru[@]}")

  if [ -n "$command" ]; then
    ssh "${args[@]}" "$target" "${remote}${command}"
  else
    [ -z "$server" ] || echo "$(printf '%s' "$server" | jq -r '.name // "server"'), $ssh_host" >&2
    ssh -t "${args[@]}" "$target" "${remote}exec \${SHELL:-/bin/bash} -l"
  fi
}

db_server() {
  load_servers
  local picked
  picked="$(printf '%s' "$SERVERS_JSON" | jq -c '[.[] | select((.roles // []) | index("postgresql"))] | first // empty')"
  if [ -z "$picked" ]; then
    picked="$(printf '%s' "$SERVERS_JSON" | jq -c 'if length == 1 then .[0] else empty end')"
  fi
  [ -n "$picked" ] || die "could not tell which server holds the database. set ssh_host:$ENV_NAME in $CONFIG"
  printf '%s' "$picked"
}

free_local_port() {
  local port=15432
  if command -v nc >/dev/null 2>&1; then
    while nc -z 127.0.0.1 "$port" >/dev/null 2>&1; do
      port=$((port + 1))
      [ "$port" -lt 15500 ] || die "no free local port between 15432 and 15500"
    done
  fi
  printf '%s' "$port"
}

cmd_psql() {
  local sql="" want_url=0 direct=0 wanted_name="" passthru=()

  while [ $# -gt 0 ]; do
    case "$1" in
      -c|--command) shift; [ $# -gt 0 ] || die "-c needs some sql"; sql="$1" ;;
      -c=*|--command=*) sql="${1#*=}" ;;
      -d|--database) shift; [ $# -gt 0 ] || die "--database needs a name"; wanted_name="$1" ;;
      --database=*) wanted_name="${1#--database=}" ;;
      --url) want_url=1 ;;
      --direct) direct=1 ;;
      -h|--help) usage; return 0 ;;
      --) shift; passthru=("$@"); break ;;
      -*) die "unknown option for psql: $1. put psql's own flags after a --" ;;
      *)
        [ -z "$sql" ] || die "only one statement at a time, quote it as one argument"
        sql="$1"
        ;;
    esac
    shift
  done

  api_ok GET "/apps/$APP_ID/databases"
  local all="$RESP_BODY" candidates count

  candidates="$(printf '%s' "$all" | jq -c '[.[] | select(.engine == "postgresql")]')"
  if [ -n "$wanted_name" ]; then
    candidates="$(printf '%s' "$candidates" | jq -c --arg n "$wanted_name" '[.[] | select(.name == $n)]')"
  fi
  count="$(printf '%s' "$candidates" | jq 'length')"

  if [ "$count" -eq 0 ]; then
    if [ -n "$wanted_name" ]; then
      echo "no postgresql database called $wanted_name is attached to $ENV_NAME" >&2
    else
      echo "no postgresql database is attached to $ENV_NAME" >&2
    fi
    local attached
    attached="$(printf '%s' "$all" | jq -r '.[] | "  \(.name), \(.engine), reachable as \(.app_attachments[0].env_var // "nothing")"')"
    if [ -n "$attached" ]; then
      echo >&2
      echo "what is attached:" >&2
      printf '%s\n' "$attached" >&2
    fi
    return 1
  fi

  if [ "$count" -gt 1 ]; then
    echo "$ENV_NAME has more than one postgresql database, so pick one with --database" >&2
    echo >&2
    printf '%s' "$candidates" | jq -r '.[] | "  \(.name)"' >&2
    return 1
  fi

  local db uri public
  db="$(printf '%s' "$candidates" | jq -c '.[0]')"
  public="$(printf '%s' "$db" | jq -r '.public_connection_uri // empty')"
  uri="$public"
  [ -n "$uri" ] || uri="$(printf '%s' "$db" | jq -r '.private_connection_uri // empty')"
  [ -n "$uri" ] || die "that database has no connection uri, which happens on sqlite"

  if [ "$want_url" -eq 1 ]; then
    printf '%s\n' "$uri"
    if [ -z "$public" ]; then
      echo "that host is the database's own machine, so the uri only works from the server" >&2
    fi
    return 0
  fi

  need psql
  parse_pg_uri "$uri"

  local ctl="" ssh_target=""
  if [ -z "$public" ] && [ "$direct" -eq 0 ]; then
    local server ssh_host ssh_user ssh_port local_port
    ssh_host="$(config_get "$CONFIG" "ssh_host:$ENV_NAME")"
    ssh_user="$(config_get "$CONFIG" "ssh_user:$ENV_NAME")"
    ssh_port="$(config_get "$CONFIG" "ssh_port:$ENV_NAME")"

    if [ -z "$ssh_host" ]; then
      server="$(db_server)"
      ssh_host="$(printf '%s' "$server" | jq -r '.public_ip // empty')"
      [ -n "$ssh_port" ] || ssh_port="$(printf '%s' "$server" | jq -r '.ssh_port // empty')"
      [ -n "$ssh_host" ] || die "that server has no public ip. set ssh_host:$ENV_NAME in $CONFIG"
    fi
    [ -n "$ssh_user" ] || ssh_user=deploy
    [ -n "$ssh_port" ] || ssh_port=22

    local_port="$(free_local_port)"
    ctl="$(mktemp -u /tmp/hatchbox-psql-XXXXXX)"
    ssh_target="$ssh_user@$ssh_host"

    echo "tunnelling to $URI_HOST:$URI_PORT through $ssh_target" >&2
    if ! ssh -f -N -M -S "$ctl" \
      -o ExitOnForwardFailure=yes -o ConnectTimeout=10 \
      -p "$ssh_port" -L "127.0.0.1:$local_port:$URI_HOST:$URI_PORT" "$ssh_target"; then
      echo >&2
      echo "could not open an ssh tunnel. hatchbox puts your key on the deploy user, so" >&2
      echo "check that ssh $ssh_target works, or set ssh_user:$ENV_NAME in $CONFIG" >&2
      return 1
    fi
    trap "ssh -S '$ctl' -O exit '$ssh_target' >/dev/null 2>&1 || true" EXIT

    URI_HOST=127.0.0.1
    URI_PORT="$local_port"
  fi

  local args=(-h "$URI_HOST" -p "$URI_PORT" -U "$URI_USER" -d "$URI_NAME")
  [ -n "$sql" ] && args+=(-c "$sql")
  [ ${#passthru[@]} -gt 0 ] && args+=("${passthru[@]}")

  local status=0
  PGPASSWORD="$URI_PASS" PGSSLMODE="${URI_SSLMODE:-prefer}" psql "${args[@]}" || status=$?

  if [ -n "$ctl" ]; then
    ssh -S "$ctl" -O exit "$ssh_target" >/dev/null 2>&1 || true
    trap - EXIT
  fi
  return "$status"
}

have_tty() {
  # the redirect to null comes first, or the shell reports the failed open itself
  : 2>/dev/null < /dev/tty
}

config_set_app() {
  local file="$1" env="$2" app="$3" tmp
  if [ ! -f "$file" ]; then
    cat > "$file" <<'HEAD'
# the apps this repo deploys to, written the way the dashboard url spells them,
# then the environment each one is. run hatchbox setup to add another.
HEAD
  fi
  [ -w "$file" ] || die "$file is not writable"
  tmp="$(mktemp)"
  awk -v env="$env" -v app="$app" '
    BEGIN { replaced = 0 }
    /^[ \t]*#/ { print; next }
    /=/ { print; next }
    {
      line = $0
      gsub(/^[ \t]+|[ \t]+$/, "", line)
      if (line == "") { print; next }
      cut = 0
      for (i = 1; i <= length(line); i++) if (substr(line, i, 1) == ":") cut = i
      if (cut > 0) {
        e = substr(line, cut + 1)
        gsub(/^[ \t]+|[ \t]+$/, "", e)
        if (e == env) { print app ":" env; replaced = 1; next }
      }
      print
    }
    END { if (!replaced) print app ":" env }
  ' "$file" > "$tmp" && mv "$tmp" "$file"
}

setup_target() {
  local found dir
  found="$(find_config || true)"
  if [ -n "$found" ]; then
    printf '%s' "$found"
    return
  fi
  dir="$PWD"
  while :; do
    if [ -d "$dir/.git" ] && [ "$dir/.hatchbox" != "$GLOBAL_CONFIG" ]; then
      printf '%s/.hatchbox' "$dir"
      return
    fi
    [ "$dir" = "/" ] && break
    dir="$(dirname "$dir")"
  done
  printf '%s/.hatchbox' "$PWD"
}

setup_token() {
  TOKEN="${HATCHBOX_API_TOKEN:-}"
  [ -n "$TOKEN" ] || TOKEN="$(config_get "$GLOBAL_CONFIG" token)"
  [ -n "$TOKEN" ] && return 0

  have_tty || die "no api token, and no terminal to ask for one. set HATCHBOX_API_TOKEN"
  echo "no api token yet. hatchbox has them under api tokens in your account settings."
  printf 'token: '
  read -r TOKEN < /dev/tty
  [ -n "$TOKEN" ] || die "nothing entered"
  touch "$GLOBAL_CONFIG"
  chmod 600 "$GLOBAL_CONFIG"
  printf 'token = %s\n' "$TOKEN" >> "$GLOBAL_CONFIG"
  echo "saved it to $GLOBAL_CONFIG"
  echo
}

# prints "slug<tab>app name<tab>account" for every app the token can see
setup_apps() {
  local accounts
  api_ok GET "/accounts"
  accounts="$RESP_BODY"
  printf '%s' "$accounts" | jq -r '.[] | "\(.id)\t\(.name)"' | while IFS=$'\t' read -r id name; do
    [ -n "$id" ] || continue
    api GET "/accounts/$id/apps"
    case "$RESP_CODE" in
      2*)
        printf '%s' "$RESP_BODY" | jq -r --arg acct "$name" '.[] | "\(.id)-\(.name)\t\(.name)\t\($acct)"'
        ;;
      *)
        local why
        why="$(printf '%s' "$RESP_BODY" | jq -r '.error // empty' 2>/dev/null || true)"
        echo "skipping ${name}${why:+, $why}" >&2
        ;;
    esac
  done
}

cmd_setup() {
  local filter="" want_app="" want_env=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --app) shift; [ $# -gt 0 ] || die "--app needs an app"; want_app="$1" ;;
      --app=*) want_app="${1#--app=}" ;;
      --as) shift; [ $# -gt 0 ] || die "--as needs an environment"; want_env="$1" ;;
      --as=*) want_env="${1#--as=}" ;;
      -h|--help) usage; return 0 ;;
      -*) die "unknown option for setup: $1" ;;
      *) filter="$1" ;;
    esac
    shift
  done

  setup_token

  local target
  target="$(setup_target)"
  CONFIG="$target"

  if [ -z "$want_app" ]; then
    have_tty || die "setup needs a terminal, or pass --app and --as"

    local list count
    list="$(mktemp)"
    setup_apps > "$list"
    if [ -n "$filter" ]; then
      awk -F'\t' -v f="$(printf '%s' "$filter" | tr 'A-Z' 'a-z')" \
        'tolower($1) ~ f || tolower($2) ~ f' "$list" > "$list.f" && mv "$list.f" "$list"
    fi
    count="$(wc -l < "$list" | tr -d ' ')"

    if [ "$count" -eq 0 ]; then
      rm -f "$list"
      if [ -n "$filter" ]; then
        die "no app matches $filter"
      fi
      die "the token can see no apps at all"
    fi

    echo
    echo "apps this token can see"
    awk -F'\t' '{ printf "  %2d  %-34s %s\n", NR, $1, $3 }' "$list"
    echo
    printf 'which one? '
    local choice
    read -r choice < /dev/tty
    case "$choice" in
      ''|*[!0-9]*) rm -f "$list"; die "that is not a number" ;;
    esac
    if [ "$choice" -lt 1 ] || [ "$choice" -gt "$count" ]; then
      rm -f "$list"
      die "there is no $choice on that list"
    fi
    want_app="$(awk -F'\t' -v n="$choice" 'NR == n { print $1 }' "$list")"
    rm -f "$list"
  fi

  if [ -z "$want_env" ]; then
    if have_tty; then
      printf 'call it what, here? [production] '
      read -r want_env < /dev/tty
    fi
    [ -n "$want_env" ] || want_env=production
  fi

  case "$want_env" in
    *[:=]*|*[[:space:]]*|"") die "an environment name cannot hold a colon, an equals or a space" ;;
  esac

  local existing=""
  if [ -f "$target" ]; then
    existing="$(config_app_for "$want_env")"
  fi
  if [ -n "$existing" ] && [ "$existing" != "$want_app" ]; then
    echo
    echo "$want_env is already $existing in $target"
    if have_tty && [ -z "${HATCHBOX_ASSUME_YES:-}" ]; then
      printf 'point it at %s instead? [y/N] ' "$want_app"
      local answer
      read -r answer < /dev/tty
      case "$answer" in
        y|Y|yes|YES) ;;
        *) echo "left alone"; return 1 ;;
      esac
    fi
  fi

  config_set_app "$target" "$want_env" "$want_app"
  echo
  echo "$want_app is $want_env in $target"

  local envs env_count
  CONFIG="$target"
  envs="$(config_envs)"
  env_count="$(printf '%s' "$envs" | grep -c . || true)"
  if [ "$env_count" -gt 1 ] && [ -z "$(config_get "$target" default)" ]; then
    echo
    echo "there is more than one environment here now, so every command wants -e"
    echo "unless one of them is the default"
    if have_tty; then
      printf 'which should it be? (blank to always pass -e) '
      local pick
      read -r pick < /dev/tty
      if [ -n "$pick" ]; then
        if printf '%s\n' "$envs" | grep -qxF -- "$pick"; then
          config_set default "$pick"
          echo "default is $pick"
        else
          echo "no environment called $pick, leaving the default unset"
        fi
      fi
    fi
  fi

  echo
  echo "environments in $target"
  local env app
  while IFS=$'\t' read -r env app; do
    [ -n "$env" ] || continue
    echo "  $env, app $app"
  done < <(config_apps)
}

usage() {
  cat <<'USAGE'
hatchbox, talks to the hatchbox api for the app you are standing in

  deploy                 queue a deploy and stream it until it lands
  deploy --sha SHA       deploy one commit instead of the tip of the branch
  deploy --no-follow     queue it and get out of the way
  deploy status          last deployed sha, then stream the most recent deploy log
  deploy --status        same thing
  restart                restart every process and stream it
  logs                   the log types on record for this environment
  logs deploy            the most recent deploy log
  logs restart           the most recent restart log
  logs 4212              a log by id, from anywhere
  psql                   open a psql on the app's database, over an ssh tunnel
  psql "select 1"        run one statement and print the result
  psql --url             print the connection uri instead of connecting
  ssh                    a shell on the server, in the app's current release
  ssh "df -h"            run one command there and come back
  ssh --server worker    name a server, by name or by role, when there are several
  run "rails db:migrate" run a command on the server, in the app's release
  run "bundle exec rake" anything that is not rails runs from the same place
  envs                   the environments this app is configured for
  setup                  pick an app off your account and write it to .hatchbox
  setup fpd              same, narrowed to apps matching fpd

  -e ENV, --env ENV      which environment to act on, anywhere in the command

the app comes from the nearest .hatchbox, looked for in the working directory and
then upward. an app is a bare line, written the way the dashboard url spells it,
followed by the environment it is:

  13673-fpd:production
  20001-fpd-qa:qa
  default = production

only the leading number is read by hatchbox, so the rest is there to tell you
which app you are looking at. hatchbox setup writes those lines for you, into the
nearest .hatchbox or, failing that, one at the root of the repo you are in.

with one environment it is used automatically, otherwise default decides and -e
beats it. a log is only reachable by id and hatchbox publishes no way to list
them, so the id of every deploy and restart started from here is written back to
the same file:

  last_deploy:production = 4212
  last_restart:production = 4213

anything deployed from the dashboard is invisible to logs and deploy status until
you hand over its id.

the api token is a secret and stays out of the repo. it is read from
HATCHBOX_API_TOKEN, then from ~/.hatchbox, which is the token file and is never
read as an app config. it takes token:ENV or a plain token:

  token = your-api-token

the database psql connects to is whichever postgresql one is attached to the app.
unmanaged clusters listen on their own machine's loopback, so psql goes through an
ssh tunnel to the server holding the database, as the deploy user hatchbox sets up.
ssh lands in /home/deploy/<app>/current, the release that is live, and falls back
to the home directory when that is not there yet. run does the same, through a
login shell so the app's environment is loaded, and it returns whatever the
command returned. a command starting with rails is special: the release directory
is read out of the motd hatchbox writes, which names every app on the box and the
rails console line for each, and the command runs there as bin/rails. when the
motd says nothing the fallback is whatever under ~/*/current has a bin/rails. if
more than one app is on the server and none of them matches this one, run says so
and stops, and app_dir settles it. quote the whole command as one argument, or
-e in it is read as hatchbox's own environment flag and taken away. both it and psql take the same
per environment overrides in the same file:

  ssh_user:production = deploy
  ssh_host:production = 203.0.113.10
  ssh_port:production = 22
  app_dir:production = /home/deploy/fpd/current

env
  HATCHBOX_API_TOKEN     overrides the token in ~/.hatchbox
  HATCHBOX_ENV           default environment, still beaten by -e
USAGE
}

need curl
need jq

ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -e|--env) shift; [ $# -gt 0 ] || die "--env needs an environment"; ENV_NAME="$1" ;;
    --env=*) ENV_NAME="${1#--env=}" ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

case "${1:-}" in
  ""|-h|--help|help) usage; exit 0 ;;
  setup) shift; cmd_setup "$@"; exit $? ;;
esac

load_config

case "$1" in
  deploy) shift; cmd_deploy "$@" ;;
  status) shift; cmd_status "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  psql) shift; cmd_psql "$@" ;;
  ssh) shift; cmd_ssh "$@" ;;
  run) shift; cmd_run "$@" ;;
  envs) shift; cmd_envs "$@" ;;
  *) echo "no command called $1" >&2; echo >&2; usage >&2; exit 1 ;;
esac
